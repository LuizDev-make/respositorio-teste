rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Verifica se o usuário é membro de uma casa
    function isMemberOfHouse(houseId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + houseId));
    }

    // Usuários - cada usuário pode ler/escrever apenas seu próprio perfil
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }

    // Casas - apenas membros podem ler, criação via transação
    match /houses/{houseId} {
      allow read: if isAuthenticated() && isMemberOfHouse(houseId);
      allow create: if isAuthenticated();
      allow update: if false; // Casas não são editadas neste MVP
      allow delete: if false;
    }

    // Vínculos (memberships) - documento ID = userId_houseId
    match /memberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Consulta de convite - permitir busca por inviteCode apenas para autenticados
    // Não expor lista completa de casas
    match /house_invites/{inviteCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // Despesas - apenas membros da casa
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() &&
        isMemberOfHouse(resource.data.houseId);
      allow create: if isAuthenticated() &&
        isMemberOfHouse(request.resource.data.houseId) &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() &&
        isMemberOfHouse(resource.data.houseId) &&
        resource.data.authorId == request.auth.uid;
      allow delete: if false; // Exclusão lógica apenas
    }

    // Divisões de despesa
    match /expense_splits/{splitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Pagamentos
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false; // Pagamentos não são editados
      allow delete: if false;
    }

    // Tarefas - apenas membros da casa
    match /tasks/{taskId} {
      allow read: if isAuthenticated() &&
        isMemberOfHouse(resource.data.houseId);
      allow create: if isAuthenticated() &&
        isMemberOfHouse(request.resource.data.houseId);
      allow update: if isAuthenticated() &&
        isMemberOfHouse(resource.data.houseId);
      allow delete: if false;
    }

    // Ocorrências de tarefas
    match /task_occurrences/{occurrenceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Itens de compras - apenas membros da casa
    match /shopping_items/{itemId} {
      allow read: if isAuthenticated() &&
        isMemberOfHouse(resource.data.houseId);
      allow create: if isAuthenticated() &&
        isMemberOfHouse(request.resource.data.houseId);
      allow update: if isAuthenticated() &&
        isMemberOfHouse(resource.data.houseId);
      allow delete: if false;
    }

    // Tokens de dispositivo
    match /device_tokens/{tokenId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // Bloquear tudo que não foi explicitamente permitido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
